# Install outside the source tree as /etc/gambit/web.env (root:gambit, 0640).
# Never put passwords or cloud API tokens in this file or in the repository.
GAMBIT_DOMAIN=gambitsystems.xyz
GAMBIT_RESEARCH_ROOT=/srv/gambit/research_platform
GAMBIT_AUTH_DATABASE=/srv/gambit/auth/auth.sqlite3
GAMBIT_SECRET_KEY_FILE=/etc/gambit/session-secret
GAMBIT_ALLOW_SUBMISSIONS=0
GAMBIT_HEALTH_STATUS_FILE=/run/gambit-health/status.json
DJANGO_SETTINGS_MODULE=web.settings
PYTHONPATH=/srv/gambit/research_platform/src
PYTHONDONTWRITEBYTECODE=1
