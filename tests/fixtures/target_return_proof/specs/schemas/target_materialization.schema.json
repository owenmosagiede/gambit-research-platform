        "role": {
          "type": "string"
        },
        "blob_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "enum": [
            "json",
            "jsonl"
          ]
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "blob_sha256",
        "format",
        "byte_count",
        "row_count"
