      "properties": {
        "role": {
          "type": "string"
        },
        "blob_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "enum": [
            "json",
            "jsonl"
          ]
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "operand_lineage": {
      "type": "object",
      "additionalProperties": false,
