{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-platform.local/schemas/target_materialization-0.4.0",
  "title": "Executable immutable return Target materialization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "id",
    "version",
    "definition",
    "state",
    "observations",
    "schedule",
    "operand_lineage",
    "semantic_content_sha256",
    "row_count",
    "status_counts",
    "research_readiness",
    "availability_coverage",
    "input_key"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "record_type": {
      "const": "target_materialization_manifest"
    },
    "id": {
      "type": "string",
      "pattern": "^MATERIALIZATION_[0-9a-f]{64}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "content_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "state": {
      "const": "ready"
