        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "content_sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
