{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-platform:alfred-pit-rows:CES0500000003:0.1.0",
  "title": "ALFRED CES0500000003 date-granularity PIT change-event rows v0.1.0",
  "description": "One source-specific change event with direct immutable raw-snapshot/source-view lineage. Vintage dates are archive reconstruction boundaries, not intraday publication or actual historic receipt timestamps. No available_at timestamp is invented. next_vintage_date is an exclusive boundary when present. The producer must separately verify actual calendar dates, source_field equals series_id plus underscore plus vintage YYYYMMDD, ordered nonoverlapping per-observation intervals, source evidence and snapshot coverage. Structural validation does not establish those semantic facts or readiness.",
  "$ref": "#/$defs/alfred_pit_row",
  "$defs": {
    "calendar_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
    },
    "canonical_decimal": {
      "type": "string",
      "pattern": "^(?:0|-?(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]))(?![\\s\\S])"
    },
    "raw_snapshot_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "content_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SNAPSHOT_[0-9a-f]{64}(?![\\s\\S])"
        },
        "version": {
          "const": "1.0.0"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "source_view_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "content_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "alfred_pit_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_id",
        "entity_id",
        "observation_date",
        "vintage_date",
        "next_vintage_date",
        "value",
        "status",
        "timing_precision",
        "raw_snapshot",
        "source_view",
        "source_raw_blob_sha256",
        "source_field"
      ],
      "properties": {
        "series_id": {
          "const": "CES0500000003"
        },
        "entity_id": {
          "const": "US"
        },
        "observation_date": {
          "$ref": "#/$defs/calendar_date"
        },
        "vintage_date": {
          "$ref": "#/$defs/calendar_date"
        },
        "next_vintage_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/calendar_date"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/canonical_decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "valid",
            "missing"
          ]
        },
        "timing_precision": {
          "const": "date"
        },
        "raw_snapshot": {
          "$ref": "#/$defs/raw_snapshot_reference"
        },
        "source_view": {
          "$ref": "#/$defs/source_view_reference"
        },
        "source_raw_blob_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "source_field": {
          "type": "string",
          "pattern": "^CES0500000003_[0-9]{8}(?![\\s\\S])"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "valid"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/canonical_decimal"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "alfred_pit_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alfred_pit_row"
      }
    }
  }
}
