    "raw_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blob_sha256",
        "format",
        "byte_count",
        "row_count",
        "role"
      ],
      "properties": {
        "blob_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "json"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "row_count": {
          "type": "null"
        },
        "role": {
          "const": "legacy_raw"
        }
      }
    },
    "gzip_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blob_sha256",
        "format",
        "byte_count",
        "row_count",
        "role",
        "codec",
        "partition",
        "semantic_sha256",
        "coverage"
      ],
      "properties": {
        "blob_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "bin"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "row_count": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "$ref": "#/$defs/token"
        },
        "codec": {
          "const": "gzip_jsonl"
        },
        "partition": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "coverage": {
          "$ref": "#/$defs/date_coverage"
        }
      }
    },
    "source_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_time",
        "observation_date",
        "entity_id",
        "value",
        "status",
        "reason_code",
        "available_at",
        "original_ingested_at",
        "source_vintage_at",
        "legacy_vintage_id",
        "legacy_revision_number",
        "vintage_id",
        "source_record_id",
        "source_ingestion_id",
        "base_currency",
        "quote_currency",
        "unit",
        "source_precision",
        "lineage_key",
        "lineage"
      ],
      "properties": {
        "reference_time": {
          "$ref": "#/$defs/native_date"
        },
        "observation_date": {
          "$ref": "#/$defs/native_date"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^FX_[A-Z]{6}$"
        },
        "value": {
          "$ref": "#/$defs/positive_decimal"
        },
        "status": {
          "const": "valid"
        },
        "reason_code": {
          "type": "null"
        },
        "available_at": {
          "type": "null"
        },
        "original_ingested_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "source_vintage_at": {
          "type": "null"
        },
        "legacy_vintage_id": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "legacy_revision_number": {
          "const": 0
        },
        "vintage_id": {
          "type": "string",
          "pattern": "^LEGACY_[a-f0-9]{64}$"
        },
        "source_record_id": {
          "type": "string",
          "pattern": "^[A-Z]{3}/[A-Z]{3}:[0-9]{4}-[0-9]{2}-[0-9]{2}:close$"
        },
        "source_ingestion_id": {
          "$ref": "#/$defs/token"
        },
        "base_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "quote_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "unit": {
          "type": "string",
          "pattern": "^[A-Z]{3}_per_[A-Z]{3}$"
        },
        "source_precision": {
          "const": "date"
        },
        "lineage_key": {
          "$ref": "#/$defs/sha256"
        },
        "lineage": {
          "type": "string",
          "pattern": "^FXSOURCE_[a-f0-9]{64}$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "base_currency": {
              "const": "AUD"
            },
            "quote_currency": {
              "const": "USD"
            },
            "unit": {
              "const": "USD_per_AUD"
            },
            "entity_id": {
              "const": "FX_AUDUSD"
            },
            "source_record_id": {
              "pattern": "^AUD/USD:"
            }
          }
        },
        {
          "properties": {
            "base_currency": {
              "const": "EUR"
            },
            "quote_currency": {
