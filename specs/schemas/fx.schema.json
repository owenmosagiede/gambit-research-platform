{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-platform.local/schemas/fx-0.5.0",
  "title": "Additive FX snapshot, recipe and compact Target contracts",
  "description": "Registry envelopes use the existing directories and shared payload namespace. Runtime adapters additionally validate exact typed bodies, decimal arithmetic, input identity, coverage, checksums and lineage.",
  "oneOf": [
    {
      "$ref": "#/$defs/registry"
    },
    {
      "$ref": "#/$defs/target_manifest"
    },
    {
      "$ref": "#/$defs/target_observation"
    },
    {
      "$ref": "#/$defs/source_observation"
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "content_sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "const": "1.0.0"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "id",
        "version",
        "body"
      ],
      "properties": {
        "schema_version": {
          "const": "0.5.0"
        },
        "record_type": {
          "enum": [
            "provider_contract",
            "dataset_definition",
            "source_view_definition",
            "policy_definition",
            "transformation_definition",
            "snapshot_manifest",
            "onboarding_evidence",
            "ingestion_receipt",
            "capability_assessment"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Z_]+[a-f0-9]{64}$"
        },
        "version": {
          "const": "1.0.0"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "body": {
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "fx_source_snapshot"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "record_type": {
                "const": "snapshot_manifest"
              },
              "body": {
                "$ref": "#/$defs/source_snapshot_body"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "body": {
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "fx_raw_snapshot"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "record_type": {
                "const": "snapshot_manifest"
              },
              "body": {
                "$ref": "#/$defs/raw_snapshot_body"
              }
            }
          }
        }
      ]
    },
    "target_manifest": {
      "type": "object",
      "required": [
        "schema_version",
        "record_type",
        "id",
        "definition",
        "state",
        "input_key",
        "partitions",
        "row_count",
        "status_counts",
        "reason_counts",
        "research_readiness",
        "readiness_capabilities",
        "semantic_content_sha256",
        "price_snapshot",
        "schedule",
        "implementation"
      ],
      "properties": {
        "schema_version": {
          "const": "0.5.0"
        },
        "record_type": {
          "const": "target_materialization_manifest"
        },
        "state": {
          "const": "ready"
        },
        "definition": {
          "$ref": "#/$defs/reference"
        },
        "price_snapshot": {
          "$ref": "#/$defs/reference"
        },
        "research_readiness": {
          "const": "uncertified"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "partitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "blob_sha256",
              "format",
              "codec",
              "byte_count",
              "row_count",
              "semantic_sha256",
              "coverage"
            ],
            "properties": {
              "format": {
                "const": "bin"
              },
              "codec": {
                "const": "gzip_jsonl"
              }
            }
          }
        }
      }
    },
    "target_observation": {
      "type": "object",
      "required": [
        "schema_version",
        "record_type",
        "id",
        "target",
        "prediction_anchor",
        "entry_time",
        "exit_time",
        "intended_end",
        "temporal_precision",
        "value",
        "status",
        "reason_code",
        "operands",
        "source_availability",
        "label_available_at",
        "original_capture_complete_at",
        "historical_eligibility_certified",
        "maturity"
      ],
      "properties": {
        "schema_version": {
          "const": "0.5.0"
        },
        "record_type": {
          "const": "target_observation"
        },
        "target": {
          "$ref": "#/$defs/reference"
        },
        "temporal_precision": {
          "const": "date"
        },
        "status": {
          "enum": [
            "valid",
            "missing",
            "invalid",
            "pending"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_availability": {
          "type": "null"
        },
        "label_available_at": {
          "type": "null"
        },
        "historical_eligibility_certified": {
          "const": false
        },
        "maturity": {
          "enum": [
            "elapsed_endpoint",
            "future_endpoint"
          ]
        },
        "operands": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "role",
              "reference_time",
              "price_observation_id"
            ],
            "properties": {
              "role": {
                "enum": [
                  "entry",
                  "exit"
                ]
              },
              "price_observation_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "native_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "positive_decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "not": {
        "pattern": "^0(\\.0+)?$"
      }
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "source_symbol": {
      "enum": [
        "AUD/USD",
        "EUR/USD",
        "GBP/USD",
        "NZD/USD",
        "USD/CNH",
        "CAD/USD",
        "CHF/USD",
        "JPY/USD",
        "CZK/USD",
        "HKD/USD",
        "HUF/USD",
        "ILS/USD",
        "MXN/USD",
        "NOK/USD",
        "PLN/USD",
        "SEK/USD",
        "SGD/USD",
        "ZAR/USD"
      ]
    },
    "date_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/native_date"
        },
        "end": {
          "$ref": "#/$defs/native_date"
        }
      }
    },
    "unknown_source_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "bar_boundary",
        "session_convention",
        "synchronization"
      ],
      "properties": {
        "timezone": {
          "type": "null"
        },
        "bar_boundary": {
          "type": "null"
        },
        "session_convention": {
          "type": "null"
        },
        "synchronization": {
          "const": "unverified"
        }
      }
    },
    "source_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_replay",
        "live_api_daily_pull",
        "exact_synchronization"
      ],
      "properties": {
        "historical_replay": {
          "const": "blocked"
        },
        "live_api_daily_pull": {
          "const": "unresolved"
        },
        "exact_synchronization": {
          "const": "blocked"
        }
      }
    },
    "raw_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "provider_symbol",
        "base_currency",
        "quote_currency",
        "unit",
        "frequency",
        "price_field",
        "price_basis",
        "timing",
        "timestamp_precision",
        "provenance_classification",
        "historical_availability",
        "historical_vintages_verified",
        "source_calendar",
        "native_vintage_policy"
      ],
      "properties": {
        "provider": {
          "const": "Twelve Data"
        },
        "provider_symbol": {
          "$ref": "#/$defs/source_symbol"
        },
        "base_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "quote_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "unit": {
          "type": "string",
          "pattern": "^[A-Z]{3}_per_[A-Z]{3}$"
        },
        "frequency": {
          "const": "daily"
        },
        "price_field": {
          "const": "close"
        },
        "price_basis": {
          "const": "unknown"
        },
        "timing": {
          "$ref": "#/$defs/unknown_source_timing"
        },
        "timestamp_precision": {
          "const": "date"
        },
        "provenance_classification": {
          "const": "retrospective_snapshot"
        },
        "historical_availability": {
          "type": "null"
        },
        "historical_vintages_verified": {
          "const": false
        },
        "source_calendar": {
          "type": "null"
        },
        "native_vintage_policy": {
          "const": "captured_snapshot_only"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider_symbol": {
                "const": "AUD/USD"
              }
            }
          },
          "then": {
            "properties": {
              "base_currency": {
                "const": "AUD"
              },
              "quote_currency": {
                "const": "USD"
              },
              "unit": {
                "const": "USD_per_AUD"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_symbol": {
                "const": "EUR/USD"
              }
            }
          },
          "then": {
            "properties": {
              "base_currency": {
                "const": "EUR"
              },
              "quote_currency": {
                "const": "USD"
              },
              "unit": {
                "const": "USD_per_EUR"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_symbol": {
                "const": "GBP/USD"
              }
            }
          },
          "then": {
            "properties": {
              "base_currency": {
                "const": "GBP"
              },
              "quote_currency": {
                "const": "USD"
              },
              "unit": {
                "const": "USD_per_GBP"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_symbol": {
                "const": "NZD/USD"
              }
            }
          },
          "then": {
            "properties": {
              "base_currency": {
                "const": "NZD"
              },
              "quote_currency": {
                "const": "USD"
              },
              "unit": {
                "const": "USD_per_NZD"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_symbol": {
                "const": "USD/CNH"
              }
            }
          },
          "then": {
            "properties": {
              "base_currency": {
                "const": "USD"
              },
              "quote_currency": {
                "const": "CNH"
              },
              "unit": {
                "const": "CNH_per_USD"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_symbol": {
                "const": "CAD/USD"
              }
            }
          },
          "then": {
            "properties": {
              "base_currency": {
                "const": "CAD"
              },
              "quote_currency": {
                "const": "USD"
              },
              "unit": {
                "const": "USD_per_CAD"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_symbol": {
                "const": "CHF/USD"
              }
            }
          },
          "then": {
            "properties": {
