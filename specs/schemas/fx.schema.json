    "source_snapshot_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "profile",
        "definition",
        "upstream_snapshots",
        "members",
        "lineage_members",
        "record_count",
        "coverage",
        "semantic_content_sha256",
        "semantic_lineage_sha256",
        "source_metadata",
        "source_evidence",
        "policy",
        "original_ingestions",
        "readiness",
        "limitation_codes",
        "original_ingestion_times",
        "completion_state"
      ],
      "properties": {
        "kind": {
          "const": "fx_source_snapshot"
        },
        "profile": {
          "const": "fx_snapshot.1.0.0"
        },
        "definition": {
          "$ref": "#/$defs/reference"
        },
        "upstream_snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/gzip_member"
              },
              {
                "properties": {
                  "role": {
                    "const": "fx_source_observations"
                  }
                }
              }
            ]
          }
        },
        "lineage_members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/gzip_member"
              },
              {
                "properties": {
                  "role": {
                    "const": "fx_source_lineage"
                  }
                }
              }
            ]
          }
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "coverage": {
          "$ref": "#/$defs/date_coverage"
        },
        "semantic_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_lineage_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_metadata": {
          "$ref": "#/$defs/raw_metadata"
        },
        "source_evidence": {
          "$ref": "#/$defs/reference"
        },
        "policy": {
          "$ref": "#/$defs/reference"
        },
        "original_ingestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1
        },
        "readiness": {
          "$ref": "#/$defs/source_readiness"
        },
        "limitation_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "original_ingestion_times": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/utc_timestamp"
          }
        },
        "completion_state": {
          "const": "complete"
        }
      }
    },
    "raw_snapshot_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "profile",
        "definition",
        "upstream_snapshots",
        "members",
        "record_count",
        "coverage",
        "semantic_content_sha256",
        "source_evidence",
        "policy",
        "source_metadata",
        "readiness"
      ],
      "properties": {
        "kind": {
          "const": "fx_raw_snapshot"
        },
        "profile": {
          "const": "fx_snapshot.1.0.0"
        },
        "definition": {
          "$ref": "#/$defs/reference"
        },
        "upstream_snapshots": {
          "type": "array",
          "maxItems": 0
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/raw_member"
          },
          "minItems": 1
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "coverage": {
          "$ref": "#/$defs/date_coverage"
        },
        "semantic_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_evidence": {
          "$ref": "#/$defs/reference"
        },
        "policy": {
          "$ref": "#/$defs/reference"
        },
        "source_metadata": {
          "$ref": "#/$defs/raw_metadata"
        },
        "readiness": {
          "$ref": "#/$defs/source_readiness"
        }
      }
    },
    "source_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_time",
        "lineage_key",
        "lineage",
        "source_row_content_sha256",
        "legacy_row_sha256",
        "legacy_canonical_path",
        "legacy_canonical_sha256",
        "legacy_canonical_row_index",
        "raw_blob_sha256",
        "raw_relative_path",
        "raw_row_index",
        "raw_datetime",
        "raw_field",
        "raw_value",
        "raw_row_sha256",
        "legacy_available_at",
        "legacy_original_release_at",
        "legacy_availability_precision",
        "availability_evidence_disposition",
        "original_ingested_at"
      ],
      "properties": {
        "reference_time": {
          "$ref": "#/$defs/native_date"
        },
        "lineage_key": {
          "$ref": "#/$defs/sha256"
        },
        "lineage": {
          "type": "string",
          "pattern": "^FXSOURCE_[a-f0-9]{64}$"
        },
        "source_row_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "legacy_row_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "legacy_canonical_path": {
          "type": "string",
          "pattern": "^production/twelve_data_fx/symbol=[A-Z]{3}_[A-Z]{3}/page=[0-9]{4}/observations\\.jsonl\\.gz$"
        },
        "legacy_canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "legacy_canonical_row_index": {
          "type": "integer",
          "minimum": 0
        },
        "raw_blob_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_relative_path": {
          "type": "string",
          "pattern": "^raw/v1/twelve_data_fx/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"
        },
        "raw_row_index": {
          "type": "integer",
          "minimum": 0
        },
        "raw_datetime": {
          "$ref": "#/$defs/native_date"
        },
        "raw_field": {
          "const": "close"
        },
        "raw_value": {
          "$ref": "#/$defs/positive_decimal"
        },
        "raw_row_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "legacy_available_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "legacy_original_release_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "legacy_availability_precision": {
          "const": "inferred"
        },
        "availability_evidence_disposition": {
          "const": "adapter_inference_not_historical_evidence"
        },
        "original_ingested_at": {
          "$ref": "#/$defs/utc_timestamp"
        }
      }
    }
